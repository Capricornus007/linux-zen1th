# zen1th KEEP fragment —— localmodconfig 裁剪後強制補回，缺一個就可能開不了機
# --- 開機/儲存的硬需求 ---
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_EXT4_FS=y
CONFIG_VAT=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
# --- 本機硬件（lspci 實測：Cezanne iGPU + MX450 + RTL8852AE + SN730 + Renoir ACP）---
CONFIG_DRM_AMDGPU=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_PCI_XGPU2=y
CONFIG_RTW89_PCI=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_DEBUGMSG=y
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
# --- dae（16 項）與 MLFS 工具鏈依賴 ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_CGROUPS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_TUN=m
CONFIG_TAP=m
# --- 其他 ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_X86_NATIVE_CPU=y
CONFIG_POWER_SUPPLY=y
CONFIG_ACPI_TAD=m
